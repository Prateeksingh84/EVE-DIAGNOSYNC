# Application
APP_NAME="EVE Healthcare API"
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/eve_healthcare
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/eve_healthcare

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Webhook
WEBHOOK_SECRET=change-this-webhook-secret-in-production

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
